# syntax=docker/dockerfile:1
# Image `ottm-web`: build web/ rồi phục vụ `dist` bằng nginx unprivileged (service `web` trong docker-compose.yml,
# profile `web`, chỉ khi COMPOSE_PROFILES=web). nginx của chủ shop chuyển `/` tới 127.0.0.1:${WEB_HOST_PORT:-3080}
# (deploy/nginx.conf.example). Build context = gốc repo. Cùng tag với ottm-server (rollback đổi cả hai).
FROM node:24-slim AS build

ENV NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY server/package.json server/
COPY web/package.json web/
RUN npm ci --workspace web --workspace packages/shared --no-audit --no-fund

COPY packages/shared packages/shared
COPY web web
# Plugin build (web/vite.config.ts) đọc mẫu này khi VITE_API_ORIGIN có giá trị. `.htaccess` sinh ra nằm trong dist nhưng
# nginx của container không phục vụ file ẩn (web-nginx.conf), nên vô hại.
COPY deploy/hostinger/htaccess.template deploy/hostinger/htaccess.template
# Origin api khi web và api dùng hai tên miền (vd web https://app.<miền>, api https://api.<miền>) — compose truyền từ
# VITE_API_ORIGIN trong deploy/.env. Trống = web gọi /api cùng tên miền (nginx chuyển /api tới api).
ARG VITE_API_ORIGIN=
RUN npm run build -w web \
 && test -f web/dist/index.html

# Ghim bản vá (nâng có chủ đích). Độc lập với NGINX_IMAGE trong CI — cái đó đóng vai nginx máy chủ của chủ shop.
# Image unprivileged: user nginx (uid 101), nghe 8080 — không cần quyền root hay capability nào.
# Healthcheck khai ở docker-compose.yml (service web), không ở đây.
FROM nginxinc/nginx-unprivileged:1.28.0-alpine

# Nhãn phân biệt với image ottm-web cũ (chỉ mang /dist, không chạy được): `docker image inspect` khi chọn tag rollback.
LABEL org.ottm.web="nginx"

USER root
# Cấu hình riêng thay cho mặc định (bỏ default.conf: entrypoint không sửa gì trên root FS chỉ đọc).
RUN rm -f /etc/nginx/conf.d/default.conf /usr/share/nginx/html/*
COPY deploy/web-nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
# Nội dung chỉ đọc với nginx (chủ root, a+rX).
RUN chmod -R a+rX,go-w /usr/share/nginx/html /etc/nginx/nginx.conf \
 && nginx -t -c /etc/nginx/nginx.conf \
 && rm -rf /tmp/*_temp /tmp/nginx.pid
USER 101

ENV NGINX_ENTRYPOINT_QUIET_LOGS=1
EXPOSE 8080
