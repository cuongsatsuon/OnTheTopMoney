# deploy/.env trên VPS — sao chép từ file này:  cp deploy/env.production.example deploy/.env && chmod 600 deploy/.env
# docker compose đọc file này để điền docker-compose.yml. KHÔNG commit deploy/.env (đã nằm trong .gitignore).
# Bí mật để trống ở đây; sinh giá trị theo gợi ý trong từng dòng. Giá trị viết liền, không ngoặc kép.

# ---------------------------------------------------------------- Tên miền
# URL công khai: https, không dấu / cuối. api dùng làm gốc cho webhook/OAuth callback và (khi ALLOWED_ORIGINS trống)
# làm ALLOWED_ORIGINS. WEB_MODE=external: đây là host api (vd https://api.example.com).
PUBLIC_BASE_URL=https://app.example.com
# TLS, cổng 80/443 và định tuyến do nginx trên máy chủ đảm nhận (chủ shop tự quản, chứng chỉ bằng certbot):
# cài site từ deploy/nginx.conf.example với cùng tên miền và các giá trị dưới đây (runbook.md mục 1.5–1.6).

# ---------------------------------------------------------------- Chế độ web
# vps (mặc định): web + api cùng VPS, cùng tên miền — deploy.sh xuất bản web ra WEB_ROOT, nginx theo nginx.conf.example.
# external: web tĩnh trên Hostinger (deploy/hostinger/publish-web-hostinger.sh), VPS chỉ chạy BE; PUBLIC_BASE_URL là
#   host api (vd https://api.example.com), nginx theo nginx-api.conf.example, deploy.sh/rollback.sh bỏ qua phần web
#   và không cần WEB_ROOT. Web và api PHẢI cùng tên miền gốc (app.example.com + api.example.com): cookie phiên
#   SameSite=Lax chỉ đi kèm request same-site (runbook.md mục 8).
WEB_MODE=vps
# Chỉ chế độ external (để trống khi vps):
#   WEB_BASE_URL     origin web trên Hostinger (https, không / cuối) — OAuth xong chuyển chủ shop về đây.
#   ALLOWED_ORIGINS  origin được gửi request ghi + nhận CORS có credentials (so khớp chính xác) — gồm WEB_BASE_URL.
#                    Trống = PUBLIC_BASE_URL.
WEB_BASE_URL=
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Thư mục và cổng trên máy chủ
# Gốc web (chỉ WEB_MODE=vps): deploy.sh chép build web vào WEB_ROOT/<tag> và đổi symlink WEB_ROOT/current.
# nginx: root WEB_ROOT/current.
# Phải có sẵn và người dùng chạy deploy.sh ghi được:  sudo install -d -o deploy -g deploy -m 755 /var/www/ottm
WEB_ROOT=/var/www/ottm
# Thư mục media công khai (bind mount vào api/worker ở /data/media). nginx phục vụ /media từ đây (chỉ đọc).
# Phải có sẵn, chủ sở hữu uid 1000 (user `node` trong container):  sudo install -d -o 1000 -g 1000 -m 755 /var/lib/ottm/media
# Sao lưu (backup) gồm thư mục này.
MEDIA_DIR_HOST=/var/lib/ottm/media
# Cổng api trên máy chủ — chỉ nghe ở 127.0.0.1 (không ra internet). nginx: upstream 127.0.0.1:API_HOST_PORT.
API_HOST_PORT=3000

# ---------------------------------------------------------------- Image
# deploy.sh tự ghi tag git SHA đang chạy vào đây; rollback.sh đổi nó. Không sửa tay.
IMAGE_TAG=

# ---------------------------------------------------------------- Postgres
# Chỉ dùng chữ và số (nằm trong URL kết nối):  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- App
# fatal | error | warn | info | debug
LOG_LEVEL=info

# App Meta thật (không phải Test App). Production chỉ khởi động khi META_APP_ENV=live nếu đã đặt META_APP_ID.
# Để trống cả hai tới Epic 2 (kết nối Meta).
META_APP_ID=
META_APP_ENV=live
# Bắt buộc khi đặt META_APP_ID.
META_APP_SECRET=
# Tuỳ chọn: Configuration ID của Facebook Login for Business (Configurations). Trống → app tự gửi danh sách quyền.
# Redirect URI phải khai trong app Meta: <PUBLIC_BASE_URL>/oauth/facebook/callback (runbook mục 6.1).
META_LOGIN_CONFIG_ID=
# Chuỗi tự đặt (≥16 ký tự), dán vào trang webhook của Meta:  openssl rand -hex 16
META_VERIFY_TOKEN=
# Threads app thật: đặt cả ID lẫn secret (thiếu một → không khởi động); production chỉ nhận THREADS_APP_ENV=live.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_APP_ENV=live

# Khoá chủ mã hoá bí mật (khoá OpenAI, token Meta) — BẮT BUỘC: thiếu hoặc sai định dạng thì
# api, worker và migrate KHÔNG khởi động (log nêu tên biến, không bao giờ log giá trị).
#   APP_ENCRYPTION_KEYS:       danh sách <keyId>:<base64 của đúng 32 byte>, phẩy ngăn cách.
#                              Sinh:  echo "k1:$(openssl rand -base64 32)"
#                              keyId chỉ gồm chữ, số, _ hoặc - (vd k1, 2026a).
#   APP_ENCRYPTION_ACTIVE_KEY: keyId dùng để mã hoá bản ghi mới, phải có trong APP_ENCRYPTION_KEYS, vd k1.
# Xoay khoá: THÊM khoá mới vào danh sách (giữ khoá cũ), đổi APP_ENCRYPTION_ACTIVE_KEY sang khoá mới.
# Bỏ khoá cũ khỏi danh sách thì mọi bí mật mã hoá bằng nó không giải mã được nữa (phải nhập lại).
# CẤT BẢN SAO APP_ENCRYPTION_KEYS Ở CHỖ RIÊNG (trình quản lý mật khẩu). Nó KHÔNG nằm trong backup:
# mất khoá này thì khoá OpenAI và token Meta trong bản backup không giải mã được (phải nhập/kết nối lại).
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_ACTIVE_KEY=
# Bí mật phiên (đọc từ các story sau):  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------- Sao lưu (restic → kho S3-compatible khác nhà cung cấp VPS)
# Ví dụ Backblaze B2 (bucket riêng tư, application key chỉ cho bucket đó):
#   RESTIC_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/ten-bucket/ottm
RESTIC_REPOSITORY=
# Khoá mã hoá kho restic:  openssl rand -base64 32
# CẤT BẢN SAO Ở CHỖ RIÊNG: mất nó là không khôi phục được bản backup nào.
RESTIC_PASSWORD=
# Với B2: keyID và applicationKey của application key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Một số nhà cung cấp S3 cần region (B2 thì không).
AWS_DEFAULT_REGION=
