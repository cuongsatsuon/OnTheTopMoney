# deploy/.env trên VPS — tạo từ file này:  cp env.production.example .env && chmod 600 .env
# docker compose (docker-compose.yml) đọc file này. KHÔNG commit deploy/.env.
# Giá trị viết liền, không ngoặc kép. Dòng bắt đầu bằng `#` là tuỳ chọn: bỏ `#` khi cần đổi mặc định.
# Chỉ có các biến app đang dùng; biến mới được thêm ở đây cùng story cần nó.

# ================================================================ 1. Bắt buộc
# URL công khai của app: https, không dấu / cuối, trùng `server_name` trong nginx (deploy/nginx.conf.example).
# api dùng làm gốc cho OAuth callback (<PUBLIC_BASE_URL>/oauth/facebook/callback, /oauth/threads/callback) và là
# origin duy nhất được gửi request ghi. Web ở Hostinger (mục 6): đây là host api (vd https://api.example.com).
PUBLIC_BASE_URL=https://app.example.com

# Mật khẩu Postgres (chỉ chữ và số — nằm trong URL kết nối):  openssl rand -hex 24
POSTGRES_PASSWORD=

# Khoá chủ mã hoá bí mật lưu trong DB (khoá OpenAI, token Meta). Thiếu/sai → api, worker, migrate không khởi động.
#   APP_ENCRYPTION_KEYS:       <keyId>:<base64 của đúng 32 byte>, nhiều khoá phẩy ngăn cách.
#                              Sinh:  echo "k1:$(openssl rand -base64 32)"
#   APP_ENCRYPTION_ACTIVE_KEY: keyId dùng để mã hoá bản ghi mới, phải có trong APP_ENCRYPTION_KEYS (vd k1).
# Xoay khoá: thêm khoá mới (giữ khoá cũ) rồi đổi ACTIVE_KEY. Bỏ khoá cũ → bí mật mã hoá bằng nó phải nhập lại.
# CẤT BẢN SAO Ở CHỖ RIÊNG (ngoài VPS): mất khoá là bí mật trong DB không giải mã được.
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_ACTIVE_KEY=

# ================================================================ 2. Máy chủ (đã có mặc định)
# Chế độ web (profile của docker compose):
#   web      → web + api cùng VPS, web chạy như service Docker `web` (mặc định, nginx theo nginx.conf.example).
#   (trống)  → web tĩnh trên Hostinger, VPS chỉ chạy BE (nginx theo nginx-api.conf.example; xem mục 6 cuối file).
COMPOSE_PROFILES=web
# Cổng trên máy chủ, chỉ nghe ở 127.0.0.1. Đổi số thì sửa cả `upstream` tương ứng trong file nginx.
# Postgres không mở cổng nào ra máy chủ, nên 5432 bận trên VPS không ảnh hưởng.
API_HOST_PORT=3000
WEB_HOST_PORT=3080
# Mức log: fatal | error | warn | info | debug. Mặc định info.
# LOG_LEVEL=info

# ================================================================ 3. Meta và Threads (kết nối Fanpage, Instagram, Threads)
# Để trống thì app vẫn chạy, chỉ màn kết nối báo chưa cấu hình. Dùng app thật (không phải Test App).
# Redirect URI cần khai trong app: <PUBLIC_BASE_URL>/oauth/facebook/callback và <PUBLIC_BASE_URL>/oauth/threads/callback.
# Facebook + Instagram: đặt cả ID lẫn secret; META_APP_ENV phải là live.
META_APP_ID=
META_APP_SECRET=
META_APP_ENV=live
# Tuỳ chọn: Configuration ID của Facebook Login for Business. Trống → app tự gửi danh sách quyền.
# META_LOGIN_CONFIG_ID=
# Verify token webhook (Story 4.1): chuỗi tự đặt ≥16 ký tự (openssl rand -hex 16), dán vào Meta khi đăng ký
# callback. Dùng cho cả /webhooks/meta và /webhooks/threads. Trống → chưa xác minh được webhook với Meta.
META_VERIFY_TOKEN=
# Threads: đặt cả ID lẫn secret (thiếu một → không khởi động); THREADS_APP_ENV phải là live.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_APP_ENV=live
# Quyền riêng tư (Story 9.1) — Meta bắt buộc trước khi cho app chạy Live. Dán vào Meta App (runbook mục 9):
#   Privacy Policy URL         <PUBLIC_BASE_URL>/privacy/policy
#   Data deletion callback URL <PUBLIC_BASE_URL>/privacy/meta/data-deletion
#   Deauthorize callback URL   <PUBLIC_BASE_URL>/privacy/meta/deauthorize
# Callback verify bằng META_APP_SECRET ở trên. Tên + email dưới đây hiện trên trang chính sách; trống → "Chưa điền".
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# ================================================================ 4. Cloudinary (ảnh bài đăng, logo, file kho kiến thức)
# Mọi ảnh/file lưu trên Cloudinary, không lưu trên máy chủ (bật backup của Cloudinary nếu gói cho phép —
# runbook.md mục Cloudinary; hệ thống không có backup tự động). Để trống thì app vẫn chạy, chỉ tính năng ảnh/file báo chưa cấu hình.
# CLOUDINARY_URL lấy ở Cloudinary Console › Settings › API Keys (dòng "API environment variable"), dạng
#   cloudinary://<api_key>:<api_secret>@<cloud_name>   — bí mật như mật khẩu, không dán vào chat/log.
# Kiểm cấu hình sau khi deploy:  docker compose exec api npm run media:check
CLOUDINARY_URL=
# Thư mục gốc trên Cloudinary (chữ, số, _ -, / ngăn cấp). Mặc định ottm. Dev dùng thư mục/tài khoản riêng.
# CLOUDINARY_FOLDER=ottm
# Dọn file Cloudinary không còn dữ liệu nào trỏ tới (cron privacy.orphan_files, 5h sáng giờ VN — runbook mục 5):
# off | dry_run (chỉ đếm) | on | force (bỏ cầu dao tỉ lệ mồ côi). Bỏ trống = dry_run (cả production): đối chiếu báo cáo
# dry_run trong log worker với thư mục trên Cloudinary thật (runbook mục 5) rồi mới đặt on. Khôi phục bản dump cũ để
# thử / diễn tập trên máy khác dùng chung thư mục Cloudinary → đặt off (runbook mục 4.2).
# MEDIA_ORPHAN_SWEEP=dry_run

# ================================================================ 5. Tag image (ottm-server, ottm-web)
# Bỏ trống = latest. Build lại cùng tag GHI ĐÈ image cũ → không quay lại được. Muốn rollback được: mỗi lần lên bản mới
# đặt tag mới (vd v1, v2, v3 hoặc git SHA ngắn) — sửa dòng dưới rồi `docker compose up -d --build`. Rollback = sửa về
# tag cũ rồi `docker compose up -d` (KHÔNG --build). Xem runbook mục 2–3.
IMAGE_TAG=latest

# ================================================================ 6. Chỉ khi web và api dùng hai tên miền
# Vd web https://app.example.com, api https://api.example.com — PHẢI cùng tên miền gốc (example.com) để cookie đăng
# nhập đi kèm. Khi đó PUBLIC_BASE_URL = tên miền api. Hai cách:
#   - web vẫn chạy trên VPS (COMPOSE_PROFILES=web): đặt cả 3 biến dưới; nginx: tên miền web → 127.0.0.1:WEB_HOST_PORT,
#     tên miền api → 127.0.0.1:API_HOST_PORT (mẫu nginx-api.conf.example). Đổi VITE_API_ORIGIN → `up -d --build`.
#   - web trên Hostinger (COMPOSE_PROFILES= trống): đặt WEB_BASE_URL, ALLOWED_ORIGINS; build web theo runbook mục 8.
#   WEB_BASE_URL     origin web (https, không / cuối) — OAuth xong chuyển chủ shop về đây.
#   ALLOWED_ORIGINS  origin được gửi request ghi + nhận CORS (phẩy ngăn cách), phải gồm WEB_BASE_URL.
#   VITE_API_ORIGIN  origin api đưa vào bản build web (container web) — thường = PUBLIC_BASE_URL.
# WEB_BASE_URL=https://app.example.com
# ALLOWED_ORIGINS=https://app.example.com
# VITE_API_ORIGIN=https://api.example.com
