# OnTheTopMoney — mẫu site nginx cho chủ shop tự quản (TLS bằng certbot). Hướng dẫn: deploy/runbook.md mục 1.5–1.6.
#
# Cài: chép thành /etc/nginx/sites-available/ottm (Debian/Ubuntu) hoặc /etc/nginx/conf.d/ottm.conf, thay các giá trị
# dưới đây cho khớp deploy/.env, rồi `sudo nginx -t && sudo systemctl reload nginx`.
#
#   app.example.com          → tên miền (host của PUBLIC_BASE_URL). Có ở: server_name, đường chứng chỉ, redirect.
#   127.0.0.1:3000           → 127.0.0.1:API_HOST_PORT (api chỉ nghe trên loopback)
#   127.0.0.1:3080           → 127.0.0.1:WEB_HOST_PORT (container web — docker compose service `web` — chỉ nghe loopback)
#   /var/www/letsencrypt     → thư mục webroot cho certbot (chỉ khi dùng `certbot certonly --webroot`)
#
# Sau mỗi lần lên bản mới/rollback KHÔNG cần reload nginx: web là container cùng cổng (compose thay container theo tag).
#
# Hành vi phải giữ (CI `nginx -t` file này; runbook mục 2 kiểm tay bằng curl sau mỗi lần lên bản):
#   /healthz, /api, /api/*, /webhooks, /webhooks/*, /oauth, /oauth/*, /privacy, /privacy/*  → api
#   còn lại    → container web (deploy/web-nginx.conf): /assets/* có → immutable 1 năm, thiếu → 404 (không phải
#                HTML); file tĩnh nếu có, không thì index.html (SPA), Cache-Control no-cache. Container quyết
#                Cache-Control cho đường web — nginx này không thêm cái thứ hai (mỗi response đúng một Cache-Control)
#   container web không trả lời → 502 text/plain "web unavailable" (không phải JSON của api)
#   mọi response (kể cả lỗi) có CSP, HSTS, X-Content-Type-Options, Referrer-Policy, X-Frame-Options, Permissions-Policy
#   SSE /api/v1/stream không đệm, không nén; đường api không bao giờ nén
#   502/503/504 do nginx sinh trên đường api → JSON {"error":{"code":"INTERNAL","message":"api unavailable"}};
#   body quá lớn (413) → JSON VALIDATION_FAILED; mọi response lỗi có Cache-Control: no-store
#   không ghi access log cho /oauth và /webhooks (URL có thể mang `code`, `hub.verify_token`)
#
# Ký hiệu cho CI: CI bỏ khối giữa ">>> REDIRECT-80" và "<<< REDIRECT-80", bỏ mọi dòng `ssl_*`, đổi
# `listen 443 ssl http2;` thành `listen 80;`, bỏ dòng `listen [::]:443`. Giữ các dòng đó đúng dạng khi sửa.

# ---------------------------------------------------------------- Biến tính theo request (cấp http)
# Lưu ý quan trọng của nginx: một `add_header` bất kỳ trong một location làm location đó MẤT toàn bộ add_header của
# server. Vì vậy mọi header chỉ đặt ở cấp server; phần khác nhau theo đường dẫn được tính bằng các map dưới đây.
# KHÔNG thêm add_header vào location.

# CSP (một giá trị cho mọi response trừ trang HTML /privacy/* của api — map $ottm_csp bên dưới):
#   res.cloudinary.com: ảnh bài đăng / logo lưu trên Cloudinary (AD-14) — không còn /media trên máy chủ.
#   Bỏ 'https://picsum.photos https://fastly.picsum.photos' khỏi img-src khi web hết dữ liệu mẫu (web/src/data/mock.ts).
#   *.fbcdn.net / *.cdninstagram.com: ảnh đại diện Fanpage / Instagram do Meta trả (Story 2.2).

# api tự đặt CSP chặt riêng cho trang HTML công khai /privacy/* (Story 9.1) → giữ của api, không thêm cái thứ hai.
# Container web không đặt CSP → SPA luôn nhận giá trị dưới đây.
map $upstream_http_content_security_policy $ottm_csp {
    ""      "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://picsum.photos https://fastly.picsum.photos https://*.fbcdn.net https://*.cdninstagram.com; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    default "";
}

# Cache-Control. Lỗi (4xx/5xx, kể cả lỗi do nginx sinh trên đường api/web) → no-store. Thành công: chuỗi rỗng =
# nginx không thêm header — đường web do container web tự đặt (immutable cho /assets, no-cache cho trang), đường api
# tự quyết.
map $status $ottm_cache_control_want {
    default  "";
    ~^[45]   "no-store";
}
# Upstream (api hoặc container web) đã tự đặt Cache-Control → giữ của nó, không thêm cái thứ hai.
map $upstream_http_cache_control $ottm_cache_control {
    ""      $ottm_cache_control_want;
    default "";
}

# Referrer-Policy: api đặt riêng `no-referrer` cho trang OAuth — giữ của api, không thêm cái thứ hai.
map $upstream_http_referrer_policy $ottm_referrer_policy {
    ""      "strict-origin-when-cross-origin";
    default "";
}

# ---------------------------------------------------------------- api (docker compose, chỉ nghe trên loopback)
upstream ottm_api {
    server 127.0.0.1:3000;
    keepalive 16;
}

# ---------------------------------------------------------------- web (docker compose service `web`, chỉ loopback)
upstream ottm_web {
    server 127.0.0.1:3080;
    keepalive 8;
}

# ---------------------------------------------------------------- HTTP → HTTPS
# >>> REDIRECT-80
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;
    server_tokens off;

    # Chỉ cần khi lấy/gia hạn chứng chỉ bằng `certbot certonly --webroot -w /var/www/letsencrypt`.
    # Với `certbot --nginx` certbot tự xử lý, khối này vô hại.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://app.example.com$request_uri;
    }
}
# <<< REDIRECT-80

# ---------------------------------------------------------------- HTTPS
server {
    # nginx ≥ 1.25.1: có thể đổi thành `listen 443 ssl;` + `http2 on;` (cách cũ chỉ in cảnh báo).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.example.com;
    server_tokens off;

    # TLS — đường mặc định của certbot (/etc/letsencrypt/live/<tên miền>/…). certbot tự gia hạn (systemd timer);
    # thêm `--deploy-hook "systemctl reload nginx"` lúc lấy chứng chỉ để nginx nạp chứng chỉ mới (runbook 1.6).
    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:ottm_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Header bảo mật (AD-19) — `always`: có cả trên 404/502 và trang lỗi.
    add_header Content-Security-Policy $ottm_csp always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy $ottm_referrer_policy always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cache-Control $ottm_cache_control always;

    # Tắt nén ở đây để đường api (SSE) không bao giờ bị nén/gom, kể cả khi nginx.conf chung bật gzip. File web do
    # container web tự nén (gzip, theo Accept-Encoding chuyển qua) — nginx này chuyển nguyên.
    gzip off;

    # api giới hạn body 1 MB và tự trả lỗi JSON 413; nginx để rộng hơn một chút để lỗi đến từ api. Quá 2 MB thì
    # nginx chặn trước — trả cùng dạng JSON (@ottm_too_large).
    client_max_body_size 2m;

    # Proxy tới api và container web — đặt ở cấp server để mọi location thừa hưởng (giống add_header: location nào
    # tự đặt proxy_set_header sẽ mất hết các dòng này).
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # api tin đúng một hop (TRUST_PROXY=true) và lấy địa chỉ cuối của X-Forwarded-For. Ghi đè bằng $remote_addr,
    # KHÔNG dùng $proxy_add_x_forwarded_for (client tự gửi X-Forwarded-For giả được).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # api không trả lời được (đang khởi động lại, container dừng, quá hạn) → JSON đúng dạng lỗi của api, giữ mã.
    # Chỉ áp cho lỗi do nginx sinh (proxy_intercept_errors tắt): 503 của chính api (/healthz) đi thẳng tới client.
    # Các named location này không ghi access log: request của /oauth, /webhooks rơi vào đây mang nguyên query bí mật.
    error_page 502 = @ottm_api_502;
    error_page 503 = @ottm_api_503;
    error_page 504 = @ottm_api_504;
    error_page 413 = @ottm_too_large;

    # ---- api: health, REST, SSE, webhook Meta/Threads, OAuth callback, trang quyền riêng tư
    location = /healthz {
        proxy_pass http://ottm_api;
    }

    # SSE: đẩy từng sự kiện ngay (không đệm), giữ kết nối lâu (api ping định kỳ).
    location = /api/v1/stream {
        proxy_pass http://ottm_api;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Từ khoá tìm `?q=` (⌘K, lọc Khách hàng — Story 4.10) có thể là SĐT / tên khách: không ghi access log, error_log
    # `crit` như /oauth (api tự log đã thay `q=REDACTED`). Đặt TRƯỚC location `/api` (regex khớp theo thứ tự).
    location ~ ^/api/v1/(search|contacts)$ {
        access_log off;
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://ottm_api;
    }

    # Tải file lên (Story 5.2 file kho kiến thức ≤10 MB gửi nguyên bytes; Story 3.1 logo base64 ~2,8 MB; Story 6.1 ảnh bài
    # ≤10 MB `POST /api/v1/media-assets` — ảnh điện thoại thường 2–6 MB): body lớn hơn mức chung 2 MB. api tự giới hạn
    # theo từng route. Đặt TRƯỚC location `/api` (regex khớp theo thứ tự).
    location ~ ^/api/v1/(media-assets|knowledge-items/(group|page)/[0-9a-f-]+/files|brand-profiles/(group|page)/[0-9a-f-]+/logo)$ {
        client_max_body_size 11m;
        proxy_pass http://ottm_api;
    }

    # Trang trạng thái xoá dữ liệu: mã xác nhận nằm trong đường dẫn → không ghi access log (như /oauth). `^~` thắng regex.
    location ^~ /privacy/status/ {
        access_log off;
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://ottm_api;
    }

    location ~ ^/(api|privacy)(/|$) {
        proxy_pass http://ottm_api;
    }

    # URL OAuth callback / webhook verify mang `code`, `hub.verify_token`: không ghi access log. error_log hạ xuống
    # `crit` vì dòng lỗi upstream của nginx in nguyên request line (kèm query). api tự log đã che bí mật.
    location ~ ^/(webhooks|oauth)(/|$) {
        access_log off;
        error_log /var/log/nginx/error.log crit;
        proxy_pass http://ottm_api;
    }

    location @ottm_api_502 {
        access_log off;
        default_type application/json;
        return 502 '{"error":{"code":"INTERNAL","message":"api unavailable"}}';
    }
    location @ottm_api_503 {
        access_log off;
        default_type application/json;
        return 503 '{"error":{"code":"INTERNAL","message":"api unavailable"}}';
    }
    location @ottm_api_504 {
        access_log off;
        default_type application/json;
        return 504 '{"error":{"code":"INTERNAL","message":"api unavailable"}}';
    }
    location @ottm_too_large {
        access_log off;
        default_type application/json;
        return 413 '{"error":{"code":"VALIDATION_FAILED","message":"request body too large"}}';
    }

    # ---- web: mọi đường còn lại → container web (SPA fallback, /assets, Cache-Control do container quyết).
    # error_page ở location thay toàn bộ error_page của server: container không trả lời → trang lỗi chữ của web (không
    # phải JSON "api unavailable"); 413 giữ dạng JSON như đường api.
    location / {
        proxy_pass http://ottm_web;
        error_page 502 503 504 = @ottm_web_unavailable;
        error_page 413 = @ottm_too_large;
    }

    location @ottm_web_unavailable {
        # types rỗng: Content-Type không lấy theo đuôi URI (vd /assets/x.js) mà luôn là text/plain.
        types { }
        default_type text/plain;
        return 502 "web unavailable\n";
    }
}
