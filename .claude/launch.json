{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app-meta-fake",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "META_FAKE=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
