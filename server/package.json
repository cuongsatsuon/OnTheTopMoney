{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch src/app/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch src/worker/main.ts",
    "start:api": "node src/app/main.ts",
    "start:worker": "node src/worker/main.ts",
    "db:dev": "node scripts/db-dev.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "set-password": "node --env-file-if-exists=.env scripts/set-password.ts",
    "emit-event": "node --env-file-if-exists=.env scripts/emit-event.ts",
    "ai-simulate": "node --env-file-if-exists=.env scripts/ai-simulate.ts",
    "media:check": "node --env-file-if-exists=.env scripts/media-check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@ottm/shared": "*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "vitest": "5.0.5"
  }
}
