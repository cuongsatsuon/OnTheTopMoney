# Sao chép thành server/.env khi cần. Để trống DATABASE_URL thì `npm run dev` ở gốc tự bật
# Postgres 18 nhúng (cổng 5433, dữ liệu .data/pg); đặt nó khi dùng Postgres riêng.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ottm
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Origin của WEB (phẩy ngăn cách): được gửi request ghi tới /api/v1 và nhận CORS có credentials (so khớp chính xác).
# Production: origin HTTPS của web — cùng VPS: = PUBLIC_BASE_URL; chế độ tách (web trên Hostinger): vd
# https://app.example.com. Dev mặc định Vite 5173/5174.
# Thử web ở origin khác api khi dev (vite preview :4173 gọi api :3000): thêm http://localhost:4173.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Bật khi api chạy sau reverse proxy (nginx) để lấy IP thật cho giới hạn đăng nhập.
# TRUST_PROXY=false
# Cookie phiên có cờ Secure (mặc định true). Chrome/Firefox nhận cookie Secure trên http://localhost;
# trình duyệt nào không nhận thì đặt false khi dev.
# COOKIE_SECURE=true
# URL công khai của API (origin, không dấu / cuối; production cùng VPS: tên miền app; chế độ tách: host api trên VPS,
# vd https://api.example.com) — gốc
# của redirect URI OAuth (<PUBLIC_BASE_URL>/oauth/facebook/callback, <PUBLIC_BASE_URL>/oauth/threads/callback),
# webhook và trang đồng ý giả.
# Bắt buộc khi NODE_ENV=production (https). Dev để trống = http://localhost:5173 (Vite, proxy /oauth sang api);
# đặt bằng URL tunnel (cloudflared) khi thử OAuth/webhook Meta thật (runbook mục 6.4) — khi đó thêm origin
# tunnel vào ALLOWED_ORIGINS (kèm cả localhost) và mở app qua tunnel.
# PUBLIC_BASE_URL=https://app.example.com
# Origin của WEB (không dấu / cuối): OAuth xong chuyển chủ shop về <WEB_BASE_URL>/trang-nhom?… Để trống = PUBLIC_BASE_URL
# (web + api cùng origin). Chế độ tách (web trên Hostinger, deploy/runbook.md mục 8): production phải https và nằm
# trong ALLOWED_ORIGINS. Thử khác origin khi dev: deploy/runbook.md mục 6.8.
# WEB_BASE_URL=http://localhost:4173
# Chỉ dev: Meta giả — nút "Kết nối Facebook" mở trang đồng ý giả cục bộ (/oauth/facebook/fake-consent),
# trả 2 Fanpage giả (một có IG Business, một có IG chưa Business); nút "Threads" mở /oauth/threads/fake-consent,
# trả 1 tài khoản Threads giả. Không cần app Meta/Threads hay tunnel.
# Production từ chối khởi động khi bật.
# META_FAKE=1
# App Meta của môi trường này. Dev dùng Meta Test App riêng (META_APP_ENV=test);
# production chỉ nhận META_APP_ENV=live khi đã đặt META_APP_ID.
# Cách tạo Meta Test App, Threads test app và tunnel callback: deploy/runbook.md mục 6.
# META_APP_ID=
# META_APP_ENV=test
# App Secret của Test App (ký appsecret_proof, kiểm chữ ký webhook). Bí mật: chỉ đặt ở server/.env.
# META_APP_SECRET=
# Configuration ID của Facebook Login for Business (tuỳ chọn). Có → hộp thoại dùng config_id (quyền khai trong
# cấu hình ở Meta); không có → app tự xin danh sách quyền qua scope. Redirect URI cần khai ở app Meta:
# <PUBLIC_BASE_URL>/oauth/facebook/callback (runbook mục 6.1).
# META_LOGIN_CONFIG_ID=
# Chuỗi tự đặt cho bước xác minh webhook của Meta, ít nhất 16 ký tự (openssl rand -hex 16).
# META_VERIFY_TOKEN=
# Phiên bản Graph API mà adapters/meta pin (dạng vNN.N, mặc định v26.0).
# META_GRAPH_VERSION=v26.0
# Threads test app riêng (Use cases › Access the Threads API › Settings: Threads App ID / Threads app secret).
# Đặt cả hai hoặc không đặt cái nào (thiếu → kết nối Threads trả META_NOT_CONFIGURED). Production chỉ nhận
# THREADS_APP_ENV=live. Redirect URI cần khai ở app Threads: <PUBLIC_BASE_URL>/oauth/threads/callback (runbook
# mục 6.3). Client gọi https://graph.threads.com (v1.0).
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_APP_ENV=test
# Thư mục trên đĩa mà /healthz đo dung lượng (>85% → 503). Production: /data/media.
# HEALTH_DISK_PATH=/
# Khoá chủ mã hoá bí mật (khoá OpenAI). Để trống khi dev: `npm run dev` ở gốc tự sinh khoá dev vào
# .data/dev-encryption-key (gitignored) và tái dùng. Production bắt buộc (xem deploy/env.production.example).
# APP_ENCRYPTION_KEYS=k1:<openssl rand -base64 32>
# APP_ENCRYPTION_ACTIVE_KEY=k1
